# Copia este archivo a `.env` y ajusta los valores.

# Modo depuración (no usar en producción).
DEBUG=false

# Correo de contacto para el "polite pool" de OpenAlex (recomendado).
CONTACT_EMAIL=tu-correo@ejemplo.com

# Clave de API de OpenDOAR (Sherpa) para descubrir más repositorios (opcional).
OPENDOAR_API_KEY=

# Orígenes permitidos para CORS (frontend Angular).
# CORS_ORIGINS=["http://localhost:4200"]

# Límites de tasa.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Descargas (scraping responsable de repositorios abiertos).
# Si se deja comentado, los libros se guardan en la carpeta «Descargas» del
# usuario: C:\Users\<tú>\Downloads\Consultor de Información
# Descomenta para forzar otra ruta, p. ej.: DOWNLOAD_DIR=D:\Manuales
# DOWNLOAD_DIR=downloads
DOWNLOAD_CONCURRENCY=5
PER_DOMAIN_DELAY_SECONDS=1.0
MAX_DOWNLOAD_MB=50
MAX_DOWNLOAD_URLS=200
RESPECT_ROBOTS=true
MAX_HARVEST_RECORDS=200
